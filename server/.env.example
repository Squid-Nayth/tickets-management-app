# ============================================================
# SecureDesk — Modèle de configuration d'environnement (.env)
# Copiez ce fichier vers .env et adaptez les valeurs locales.
# Ne commitez JAMAIS le fichier .env réel contenant vos secrets !
# ============================================================

# Port du serveur Express
PORT=5000

# Base de données MySQL (Compte applicatif dédié - jamais root !)
DB_HOST=localhost
DB_PORT=3306
DB_USER=securedesk_user
DB_PASSWORD=mot_de_passe_robuste
DB_NAME=securedesk

# Clé secrète pour la signature des jetons / sessions
JWT_SECRET=changez_cette_cle_secrete_aleatoire_pour_la_prod
